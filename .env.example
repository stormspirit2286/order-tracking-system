# Copy file này thành .env rồi điền giá trị thật
# cp .env.example .env
# File .env KHÔNG được commit lên git

# PostgreSQL
POSTGRES_USER=postgres
POSTGRES_PASSWORD=your_secure_password_here

# JWT — phải dài ít nhất 256 bit (32 ký tự) cho HS256
JWT_SECRET_KEY=your-super-secret-key-for-jwt-must-be-at-least-256-bits-long
JWT_ACCESS_TOKEN_EXPIRATION=86400000
JWT_REFRESH_TOKEN_EXPIRATION=604800000
